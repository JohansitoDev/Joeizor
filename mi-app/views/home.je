imp Navbar from "components/Navbar"
imp Counter from "components/Counter"

state count = 0
state inputName = ""
isLogged = true
name = "Johan"
PI = 3.1416
users = ["Ana", "Luis", "Marta"]

class Animal
  func speak()
    text class="text-slate-500" "Sonido del animal base" end
  end
end

class Cat extends Animal
  func speak()
    text class="font-semibold text-indigo-700" "Joeizor permite sobrescribir metodos" end
  end
end

cat = new Cat()

func Greeting()
  text class="text-4xl font-bold tracking-tight text-slate-900" "Hola, {name}" end
end

Navbar()

sec class="mx-auto max-w-5xl px-6 py-12"
  sec class="rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200"
    Greeting()
    text class="mt-3 text-lg text-slate-600" "Una interfaz en .je, compilada con Rust y renderizada en el navegador." end
    sec class="mt-8 grid gap-4 md:grid-cols-2"
      Counter()
      Counter()
    end
    sec class="mt-8 flex flex-wrap items-center gap-3"
      text class="font-medium text-slate-700" "Contador de la página: {count}" end
      btn class="rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" onClick={count++}
        text "Sumar" end
      end
    end
    if count
      text class="mt-4 rounded-lg bg-emerald-50 p-4 text-emerald-800" "El contador tiene valor." end
    else if isLogged
      text class="mt-4 rounded-lg bg-indigo-50 p-4 text-indigo-800" "Bienvenido, {name}. PI = {PI}" end
    else
      text class="mt-4 rounded-lg bg-amber-50 p-4 text-amber-800" "Inicia sesion para continuar." end
    end
    cat.speak()
  end
end

bl

sec class="mx-auto max-w-5xl px-6 pb-12"
  sec class="grid gap-8 rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200 md:grid-cols-2"
    sec
      text class="text-2xl font-semibold text-slate-900" "Formulario reactivo" end
      input class="mt-4 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" type="text" placeholder="Escribe tu nombre" bind={inputName} end
      if inputName
        text class="mt-3 text-indigo-700" "Hola, {inputName}" end
      end
    end
    sec
      text class="text-2xl font-semibold text-slate-900" "Lista de usuarios" end
      list class="mt-4 space-y-2"
        for user in users
          item class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-700"
            text "{user}" end
          end
        end
      end
    end
  end
end
